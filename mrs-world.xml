        <geom name="corner_3" type="box" size="0.035 0.035 0.0001" pos="-0.9 0.9 0.001" material="aruco_mat_3" contype="0" conaffinity="0"/>
        <geom name="corner_4" type="box" size="0.035 0.035 0.0001" pos="-0.9 -0.9 0.001" material="aruco_mat_4" contype="0" conaffinity="0"/> -->

        <!-- Add inside <worldbody>, after the corner geoms -->
        <body name="obstacle_0" pos="0 0 0.05">
            <geom name="obstacle_0_geom" type="cylinder" size="0.08 0.05" rgba="0.8 0.2 0.2 1"/>
        </body>
        <body name="obstacle_1" pos="0 0 0.05">
            <geom name="obstacle_1_geom" type="cylinder" size="0.08 0.05" rgba="0.8 0.2 0.2 1"/>
        </body>
        <body name="obstacle_2" pos="0 0 0.05">
