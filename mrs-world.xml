        <geom name="corner_4" type="box" size="0.035 0.035 0.0001" pos="-0.9 -0.9 0.001" material="aruco_mat_4" contype="0" conaffinity="0"/> -->

        <!-- Goal marker (position set at runtime from JSON) -->
        <body name="goal_marker" pos="0 0 -5">
            <geom name="goal_geom" type="cylinder" size="0.03 0.001" rgba="0.1 0.9 0.1 1" contype="0" conaffinity="0"/>
        </body>

