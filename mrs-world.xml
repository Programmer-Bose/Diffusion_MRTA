<mujoco model="robot_arena">
    <compiler angle="degree" coordinate="local"/>
    <option integrator="RK4" timestep="0.002"/>

    <asset>
        <texture name="floor_tex" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
        <material name="floor_mat" texture="floor_tex" texrepeat="5 5" texuniform="true"/>

        <!-- <texture name="aruco_tex_1" type="2d" file="6x6_1000-102.png"/>
        <material name="aruco_mat_1" texture="aruco_tex_1"/>
