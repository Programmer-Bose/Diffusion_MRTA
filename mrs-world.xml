        <material name="aruco_mat_4" texture="aruco_tex_4"/> -->

        <!-- <texture name="robot_aruco_tex" type="2d" file="6x6_1000-101.png"/>
        <material name="robot_aruco_mat" texture="robot_aruco_tex"/> -->
    </asset>

    <option integrator="RK4" timestep="0.002" gravity="0 0 -9.81"/>
    <visual>
        <global offwidth="1920" offheight="1080"/>
    </visual>

    <worldbody>
        <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>
        
        <geom name="floor" type="plane" size="1 1 .25" material="floor_mat" friction="2.0 0.005 0.0001"/>

        <camera name="overhead_cam" pos="0 0 1.8" xyaxes="1 0 0 0 1 0" fovy="60"/>

        <body name="goal_marker" pos="0 0 0.05">
            <geom name="goal_marker_geom" type="sphere" size="0.025" rgba="0.1 0.9 0.1 0.6" contype="0" conaffinity="0"/>
        </body>

        <!-- <geom name="corner_1" type="box" size="0.035 0.035 0.0001" pos="0.9 0.9 0.001" material="aruco_mat_1" contype="0" conaffinity="0"/>
